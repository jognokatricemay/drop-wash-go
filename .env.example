# Copy this file to .env and fill in your own values.
# .env is ignored by git, so passwords never get uploaded.

SECRET_KEY=change-this-to-any-long-random-text

# Local XAMPP defaults (user root, no password)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dropwashgo

# Online database (TiDB Cloud) only: encrypted connection.
# DB_SSL_CA = path to the downloaded CA certificate (or paste the certificate text on Vercel); leave empty to skip checking it
DB_SSL=0
DB_SSL_CA=

# 1 = create tables + sample data on startup if the database is empty (leave 0 on Vercel)
AUTO_INIT_DB=0
