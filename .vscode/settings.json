{
  // Flask templates use Jinja ({% %} / {{ }}). Prettier's HTML formatter can break them,
  // so templates are treated as Jinja and not auto-formatted on save.
  "files.associations": {
    "**/app/templates/**/*.html": "jinja-html"
  },
  "[jinja-html]": {
    "editor.formatOnSave": false
  },
  "emmet.includeLanguages": {
    "jinja-html": "html"
  },
  // Use the project's virtual environment (.venv) for Python, the terminal and the debugger
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true
}
